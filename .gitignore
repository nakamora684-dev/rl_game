.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.DS_Store

# training artifacts (keep folders, ignore big files)
logs/*
models/*
results/*
!logs/.gitkeep
!models/.gitkeep
!results/.gitkeep
# but allow small committed final results if you want:
# !results/final/

# Graphify: keep reviewable outputs available to share, not local caches/previews.
graphify-out/cache/
graphify-out/source-previews/
graphify-out/.graphify*
