{
  "_comment": "Experiment-0 defaults (starting points, not tuned). CLI flags override these.",
  "ppo": {
    "total_timesteps": 3000000,
    "n_envs": 8,
    "n_workers": 0,
    "n_steps": 512,
    "n_epochs": 8,
    "minibatch_size": 512,
    "lr": 0.0003,
    "lr_final_frac": 0.1,
    "gamma": 0.995,
    "gae_lambda": 0.95,
    "clip_range": 0.2,
    "ent_coef": 0.01,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5,
    "target_kl": 0.03,
    "normalize_advantages": true,
    "normalize_rewards": true,
    "reward_clip": 10.0,
    "seed": 0,
    "device": "auto"
  },
  "network": {
    "group_embed": 32,
    "hidden": 128,
    "n_res_blocks": 2,
    "activation": "silu",
    "layer_norm": true,
    "share_trunk": false
  },
  "env": {
    "opponent": "rule_based",
    "start_jitter": 0.0
  }
}
